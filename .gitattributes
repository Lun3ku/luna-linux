# Luna is built on Linux, so line endings are LF only, no matter which system
# the repository was cloned on. A script with CRLF in its shebang does not run
# on Linux at all: the kernel looks for an interpreter literally named
# "/usr/bin/env bash\r" and fails to find it.
* text=auto eol=lf

# Binary files must not be converted.
*.png  binary
*.gpg  binary
*.ttf  binary
