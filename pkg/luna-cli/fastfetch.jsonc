// Сводка о системе. Логотип — луна из /usr/share/luna/logo.txt,
// цвета в нём подставляются через $1 и $2, поэтому файл остаётся
// обычным текстом без управляющих последовательностей.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "/usr/share/luna/logo.txt",
        "color": {
            "1": "38;2;232;228;244",
            "2": "38;2;180;160;255"
        },
        "padding": { "top": 1, "right": 4 }
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        { "type": "title", "color": { "user": "38;2;180;160;255", "host": "38;2;139;213;255" } },
        "separator",
        { "type": "os",      "key": "os",     "keyColor": "38;2;180;160;255" },
        { "type": "kernel",  "key": "kernel", "keyColor": "38;2;180;160;255" },
        { "type": "uptime",  "key": "uptime", "keyColor": "38;2;180;160;255" },
        { "type": "packages","key": "pkgs",   "keyColor": "38;2;180;160;255" },
        { "type": "shell",   "key": "shell",  "keyColor": "38;2;180;160;255" },
        { "type": "wm",      "key": "wm",     "keyColor": "38;2;180;160;255" },
        { "type": "terminal","key": "term",   "keyColor": "38;2;180;160;255" },
        { "type": "cpu",     "key": "cpu",    "keyColor": "38;2;139;213;255" },
        { "type": "memory",  "key": "memory", "keyColor": "38;2;139;213;255" },
        // Только корень: иначе в список лезут все примонтированные тома,
        // включая сетевые и служебные, и сводка перестаёт читаться.
        { "type": "disk",    "key": "disk",   "keyColor": "38;2;139;213;255", "folders": "/" },
        "break",
        "colors"
    ]
}
