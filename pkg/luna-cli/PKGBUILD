# Maintainer: Luna Linux
pkgname=luna-cli
pkgver=0.1.0
pkgrel=1
pkgdesc="Luna Linux shell and command-line tools with ready-made settings"
arch=('any')
url="https://github.com/luna-linux"
license=('GPL-3.0-or-later')

# The dependency list is kept in a separate file: scripts/check-packages.sh
# validates it, and it allows a comment next to every line.
depends=($(grep -vE '^[[:space:]]*(#|$)' "$startdir/depends.txt" | awk '{print $1}'))

source=('config.fish'
        'starship.toml'
        'fastfetch.jsonc'
        'luna-logo.txt'
        'luna-tldr-update.service'
        'luna-tldr-update.timer'
        '90-luna-cli.preset')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  # The configs go into /etc/skel: every new user receives them, and from then
  # on they are the user's own - a package update will not overwrite them.
  # fish is made the default shell by the installer (useradd -s /usr/bin/fish);
  # changing somebody else's account from a package would be wrong.
  install -Dm644 "$srcdir/config.fish"   "$pkgdir/etc/skel/.config/fish/config.fish"
  install -Dm644 "$srcdir/starship.toml" "$pkgdir/etc/skel/.config/starship.toml"
  install -Dm644 "$srcdir/fastfetch.jsonc" "$pkgdir/etc/skel/.config/fastfetch/config.jsonc"

  # The logo lives outside /etc/skel: it is shared and maintained by the
  # distribution rather than by the user. Its colours are given as the markers
  # $1 and $2, which keeps the file plain text with no escape sequences.
  install -Dm644 "$srcdir/luna-logo.txt" "$pkgdir/usr/share/luna/logo.txt"

  # Keeping the tldr cache filled. These are user units rather than system
  # ones: tealdeer keeps its cache in ~/.cache, so the update has to run as the
  # user who will read it.
  install -Dm644 "$srcdir/luna-tldr-update.service" \
    "$pkgdir/usr/lib/systemd/user/luna-tldr-update.service"
  install -Dm644 "$srcdir/luna-tldr-update.timer" \
    "$pkgdir/usr/lib/systemd/user/luna-tldr-update.timer"
  install -Dm644 "$srcdir/90-luna-cli.preset" \
    "$pkgdir/usr/lib/systemd/user-preset/90-luna-cli.preset"

  # The same belt and braces as in luna-desktop: a preset is only applied by
  # systemctl --user preset-all, so the enabled state is shipped as a symlink
  # as well. systemd reads .wants out of /usr/lib too.
  install -d "$pkgdir/usr/lib/systemd/user/timers.target.wants"
  ln -s ../luna-tldr-update.timer \
    "$pkgdir/usr/lib/systemd/user/timers.target.wants/luna-tldr-update.timer"
}
