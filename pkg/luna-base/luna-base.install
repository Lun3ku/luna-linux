# The boot splash theme is selected with the supported tool rather than by
# overwriting /etc/plymouth/plymouthd.conf: that file belongs to the plymouth
# package, and plymouth-set-default-theme knows where to write by itself.

_set_plymouth_theme() {
  if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme luna >/dev/null 2>&1 || true
  fi
}

post_install() {
  _set_plymouth_theme
  cat <<'MSG'

Luna Linux: the base settings are installed.

To apply the default set of services (systemd-oomd, btrfs snapshots, mirror
and package cache maintenance), run:

    systemctl preset-all

On a system being installed, the installer does this automatically.

MSG
}

post_upgrade() {
  _set_plymouth_theme
}

pre_remove() {
  # Restore the stock theme, otherwise plymouth keeps pointing at a directory
  # that is about to disappear and the initramfs fails to build.
  if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme bgrt >/dev/null 2>&1 || true
  fi
}
