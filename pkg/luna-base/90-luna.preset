# Luna Linux defaults. Processed before 99-default.preset, which says
# "disable *", and the first matching rule wins, which is why these enables
# take effect. Applied by systemctl preset-all (the installer calls it).

# Without oomd, running out of memory freezes the machine solid instead of
# killing a single process. That is one of the most noticeable quality-of-life
# improvements there is.
enable systemd-oomd.service

enable NetworkManager.service
enable systemd-timesyncd.service
enable fstrim.timer

# Maintenance: package cache cleanup, fresh mirrors.
enable paccache.timer
enable reflector.timer

# Firmware metadata refresh. The updates themselves are never applied on
# their own: fwupdmgr asks first, as it should for something that writes to a
# BIOS chip.
enable fwupd-refresh.timer

# Snapshots and rollback entries in the GRUB menu.
enable snapper-timeline.timer
enable snapper-cleanup.timer
enable grub-btrfsd.service
