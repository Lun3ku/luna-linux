# The Luna Linux boot splash.
#
# Built on the stock two-step module, the same one the spinner theme uses.
# The throbber frames and the helper images are not duplicated but taken from
# spinner through symbolic links: drawing our own white throbber for the same
# thirty frames would serve no purpose, and on a dark background it looks
# right as it is. What is ours here is the moon watermark and the colours.

[Plymouth Theme]
Name=Luna
Description=A moon over a night gradient
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/luna

# The background repeats the wallpaper gradient: nearly black at the top,
# slightly lighter towards the bottom.
BackgroundStartColor=0x0b0a12
BackgroundEndColor=0x1c1a28

# The progress bar in the accent lavender.
ProgressBarBackgroundColor=0x2a2739
ProgressBarForegroundColor=0xb4a0ff

Font=Adwaita Sans 12
TitleFont=Adwaita Sans Light 30
MonospaceFont=Adwaita Mono 12

# The throbber sits slightly below centre, the watermark on centre.
HorizontalAlignment=.5
VerticalAlignment=.72
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.42

DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382

Transition=none
TransitionDuration=0.0
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false
