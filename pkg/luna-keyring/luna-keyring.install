# Fills the pacman keyring with our key. The same approach archlinux-keyring
# uses: the package drops the public key and the trust file into
# /usr/share/pacman/keyrings, and the install script tells pacman-key to pick
# them up.

post_install() {
  if usr/bin/pacman-key -l >/dev/null 2>&1; then
    usr/bin/pacman-key --populate luna
  fi
}

post_upgrade() {
  if usr/bin/pacman-key -l >/dev/null 2>&1; then
    usr/bin/pacman-key --populate luna
  fi
}

pre_remove() {
  # Remove the key from the keyring: otherwise trust remains for a key whose
  # files are no longer on the system.
  if usr/bin/pacman-key -l >/dev/null 2>&1; then
    local fpr
    while IFS=: read -r fpr _; do
      [ -n "$fpr" ] && usr/bin/pacman-key --delete "$fpr" 2>/dev/null
    done < usr/share/pacman/keyrings/luna-trusted
  fi
}
