# Maintainer: Luna Linux
pkgname=luna-keyring
pkgver=0.1.0
pkgrel=1
pkgdesc="The key the Luna Linux packages are signed with"
arch=('any')
url="https://github.com/luna-linux"
license=('GPL-3.0-or-later')

# Depending on pacman is not a formality but an ordering constraint. The
# scriptlet below calls pacman-key; if the package depended on nothing, pacman
# could install it before pacman itself, and the scriptlet would quietly do
# nothing.
depends=('pacman')

install="$pkgname.install"
source=('luna.gpg'
        'luna-trusted')
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm644 "$srcdir/luna.gpg"     "$pkgdir/usr/share/pacman/keyrings/luna.gpg"
  install -Dm644 "$srcdir/luna-trusted" "$pkgdir/usr/share/pacman/keyrings/luna-trusted"
}
