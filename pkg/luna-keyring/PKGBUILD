# Maintainer: Luna Linux
pkgname=luna-keyring
pkgver=0.1.0
pkgrel=1
pkgdesc="Ключ, которым подписаны пакеты Luna Linux"
arch=('any')
url="https://github.com/luna-linux"
license=('GPL-3.0-or-later')

# Зависимость от pacman не формальность, а порядок установки. Скриптлет
# ниже зовёт pacman-key; если бы пакет ни от чего не зависел, pacman мог бы
# поставить его раньше самого себя, и скриптлет тихо ничего бы не сделал.
depends=('pacman')

install="$pkgname.install"
source=('luna.gpg'
        'luna-trusted')
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm644 "$srcdir/luna.gpg"     "$pkgdir/usr/share/pacman/keyrings/luna.gpg"
  install -Dm644 "$srcdir/luna-trusted" "$pkgdir/usr/share/pacman/keyrings/luna-trusted"
}
