// The Luna Linux panel.
//
// The icons are written as JSON escapes \uXXXX rather than as literal
// characters. That is not a whim: Nerd Font glyphs live in the Unicode
// private use area and are easily lost when a file passes through tools and
// editors - they already vanished silently once, leaving the panel without
// icons. As escapes the file stays pure ASCII, and the JSON parser decodes them.
//
// Every code was checked with fc-match ":charset=<code>": the icons come
// from Symbols Nerd Font Mono, which is expected - our main font is the
// plain JetBrains Mono, see the comment in depends.txt.
//
// The module names were checked against the waybar 0.15 man pages.
{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,

    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["hyprland/window"],
    "modules-right": [
        "privacy",
        "systemd-failed-units",
        "wireplumber",
        "network",
        "bluetooth",
        "power-profiles-daemon",
        "battery",
        "clock",
        "tray"
    ],

    // Workspace numbers rather than icons: a dot tells you neither which
    // workspace is active nor how many there are. persistent-workspaces keeps
    // five slots at all times, so the panel does not jump when a new one appears.
    // sort-by is exactly "number": there is no sort-by-number parameter, and
    // waybar ignores it silently.
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by": "number",
        "persistent-workspaces": { "*": 5 }
    },

    "hyprland/submap": {
        "format": "{}",
        "tooltip": false
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 60,
        "separate-outputs": true,
        "rewrite": { "": "Luna" }
    },

    // Shows when something is playing sound or recording the screen.
    // A small thing that saves a lot of awkwardness.
    "privacy": {
        "icon-spacing": 6,
        "icon-size": 13,
        "modules": [
            { "type": "screenshare" },
            { "type": "audio-in" }
        ]
    },

    // If a service has failed, it is visible at once rather than a week later.
    "systemd-failed-units": {
        "format": "\uf071 {nr_failed}",
        "format-ok": "",
        "system": true,
        "user": true
    },

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf026 —",
        "format-icons": ["\uf026", "\uf027", "\uf028"],
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    "network": {
        "format-wifi": "\uf1eb {signalStrength}%",
        "format-ethernet": "\uf0ac",
        "format-disconnected": "\uf127",
        "tooltip-format-wifi": "{essid}  {ipaddr}",
        "tooltip-format-ethernet": "{ifname}  {ipaddr}",
        "tooltip-format-disconnected": "No network",
        "on-click": "kitty -e nmtui"
    },

    // Power saver / balanced / performance, switched by clicking. The icons
    // are a leaf, scales and a bolt; every code was checked with
    // fc-match ":charset=<code>" and comes from Symbols Nerd Font Mono.
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip": true,
        "tooltip-format": "Power profile: {profile}",
        "format-icons": {
            "default":     "\uf24e",
            "power-saver": "\uf06c",
            "balanced":    "\uf24e",
            "performance": "\uf0e7"
        }
    },

    "bluetooth": {
        "format": "\uf294",
        "format-disabled": "",
        "format-connected": "\uf294 {num_connections}",
        "tooltip-format-connected": "{device_enumerate}",
        "on-click": "blueman-manager"
    },

    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon} {capacity}%",
        "format-charging": "\uf0e7 {capacity}%",
        "format-plugged": "\uf1e6 {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "tooltip-format": "{timeTo}"
    },

    // The 12-hour format by default.
    //
    // The locale parameter is deliberately NOT set here. Pinning the module
    // to "en_US.UTF-8" switched the clock off entirely on a system where that
    // locale had not been generated:
    //     module clock: Disabling module "clock",
    //     locale::facet::_S_create_c_locale name not valid
    // The locale is generated by the luna-release package instead, and %p
    // (AM/PM) works correctly both there and in the fallback C locale.
    "clock": {
        "format": "\uf017 {:%I:%M %p}",
        "format-alt": "{:%d %B, %A}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": { "today": "<span color='#b4a0ff'><b>{}</b></span>" }
        }
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
