/* The Luna Linux menu. Used as the launcher (Super+R), as the window
 * switcher (Super+Tab) and as the clipboard history (Super+Shift+V). */

* {
    base:     #12111a;
    surface:  #1b1926;
    overlay:  #2a2739;
    text:     #e8e4f4;
    subtext:  #9a93b3;
    accent:   #b4a0ff;

    background-color: transparent;
    text-color:       @text;
    font:             "JetBrains Mono 12";
}

configuration {
    show-icons:     true;
    icon-theme:     "Papirus-Dark";
    display-drun:   "Run";
    display-window: "Windows";
    drun-display-format: "{name}";
    kb-cancel:      "Escape";
}

window {
    width:            42%;
    border-radius:    16px;
    background-color: @surface;
    padding:          16px;
}

inputbar {
    children:         [ prompt, entry ];
    padding:          10px 14px;
    spacing:          10px;
    border-radius:    12px;
    background-color: @overlay;
    margin:           0 0 12px 0;
}

prompt { text-color: @accent; }
entry  { placeholder: "Search"; placeholder-color: @subtext; }

listview {
    lines:        9;
    scrollbar:    false;
    spacing:      4px;
    fixed-height: false;
}

element {
    padding:       9px 12px;
    border-radius: 10px;
    spacing:       10px;
}

/* The state colours have to be spelled out. Setting only "element selected"
 * leaves the ordinary rows to rofi's built-in default theme, which paints them
 * cream with dark text - so the menu came up as a pale block sitting inside a
 * dark window. The states are named <row state>.<entry state>: normal rows,
 * every other row, the highlighted one. */
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @text;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @accent;
    text-color:       @base;
}

/* An "active" entry is the current window in the switcher. */
element normal.active,
element alternate.active {
    background-color: transparent;
    text-color:       @accent;
}

element-icon { size: 22px; background-color: transparent; }
/* inherit, not @text: without it the text keeps one colour and stays
 * unreadable on the highlighted row. */
element-text { vertical-align: 0.5; background-color: transparent; text-color: inherit; }
