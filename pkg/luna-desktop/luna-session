#!/usr/bin/env bash
# Starts the Luna desktop.
#
# It exists because Hyprland registers TWO sessions, and the choice between
# them is not cosmetic:
#
#   hyprland.desktop        -> /usr/bin/start-hyprland
#   hyprland-uwsm.desktop   -> uwsm start -e -D Hyprland hyprland.desktop
#
# The first one creates no systemd session: graphical-session.target stays
# inactive, XDG_CURRENT_DESKTOP stays empty, and the panel, the wallpaper, the
# notifications and the polkit agent stay dead, because all of them are bound
# to that target. Verified on an installed system: is-active reported inactive
# for every one of them.
#
# The login screen points at this script so that the correct variant always
# starts by default, rather than whichever happens to come first in the list of
# sessions.
set -euo pipefail

if command -v uwsm >/dev/null 2>&1; then
    exec uwsm start -e -D Hyprland hyprland.desktop
fi

# The fallback: without uwsm, bring the session up ourselves, otherwise the
# desktop would be nothing but an empty screen.
exec Hyprland
