#!/usr/bin/env bash
# Sets the Luna Linux wallpaper.
#
# Why swaybg and not hyprpaper: hyprpaper 0.8.4 crashes with SIGSEGV when the
# system has no working EGL, which means in any virtual machine without a GPU
# passed through, and it crashes even on Hyprland's own wallpaper. swaybg draws
# through cairo and ordinary wl_shm buffers, so it always works.
# hyprpaper stays installed: anyone with a GPU who wants IPC control can switch
# to it, see docs/decisions.md.
#
# Your own wallpaper: put the path to an image in ~/.config/luna/wallpaper and run
#     systemctl --user restart luna-wallpaper
set -euo pipefail

DEFAULT=/usr/share/backgrounds/luna/luna.png
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/luna/wallpaper"

img=$DEFAULT
if [[ -r $CONF ]]; then
  candidate=$(head -n1 "$CONF")
  # If the file contains nonsense, showing the default wallpaper beats leaving
  # somebody with a black screen.
  [[ -n $candidate && -r $candidate ]] && img=$candidate
fi

exec swaybg --mode fill --image "$img"
