#!/usr/bin/env bash
# Shows the current key bindings.
#
# The list is read from Hyprland itself with "hyprctl binds", not from a file
# kept alongside the config. A cheat sheet maintained by hand drifts from
# reality the first time somebody edits a binding and forgets the sheet; this
# one cannot, because it asks the running compositor what is actually bound.
#
# What each binding does comes from its description. That is not a nicety: a
# Lua config reports its dispatcher to hyprctl as "__lua" and its argument as
# the number of an internal callback, so without a description a line here
# reads "Super+1  __lua 56". hyprland.lua gives every binding one. Anything
# that has none falls back to the dispatcher, which is what a legacy
# hyprland.conf reports and is readable enough.
set -euo pipefail

mod_name() {
    # Hyprland reports modifiers as a bitmask. 64 is SUPER, 8 is ALT,
    # 4 is CTRL, 1 is SHIFT.
    local m=$1 out=""
    (( m & 64 )) && out+="Super+"
    (( m & 4 ))  && out+="Ctrl+"
    (( m & 8 ))  && out+="Alt+"
    (( m & 1 ))  && out+="Shift+"
    printf '%s' "$out"
}

list() {
    local mods key what
    hyprctl binds -j | jq -r '.[] | [
        .modmask,
        .key,
        (if (.has_description // false)
         then (.description | tostring)
         else ((.dispatcher // "") + " " + (.arg // "")) end)
    ] | @tsv' |
    while IFS=$'\t' read -r mods key what; do
        printf '%-22s %s\n' "$(mod_name "$mods")${key}" "$what"
    done | sort
}

if command -v rofi >/dev/null 2>&1 && [[ -n ${WAYLAND_DISPLAY:-} ]]; then
    # Wider than the launcher on purpose: this list is two columns, and at
    # the shared width the descriptions were cut off mid-word.
    list | rofi -dmenu -i -p "Keys" -no-custom -theme-str 'window { width: 58%; }'
else
    list
fi
