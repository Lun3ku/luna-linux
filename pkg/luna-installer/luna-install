#!/usr/bin/env bash
# The Luna Linux installer.
#
# The interface is dialog: full-screen windows, menus and buttons in a terminal.
# The interface text is English, like the rest of the system, and so are the
# comments, which are here for whoever edits this file.
#
# The disk layout the installer creates:
#
#   ESP (fat32, 1 GiB)  -> /efi        UEFI only
#   btrfs (everything else)
#       @         -> /
#       @home     -> /home
#       @snapshots-> /.snapshots
#       @log      -> /var/log
#       @pkg      -> /var/cache/pacman/pkg
#
# /boot deliberately lives INSIDE btrfs rather than on the ESP: grub-btrfs
# boots into a snapshot, and for that the kernel and the modules have to be
# captured in the snapshot along with the system. GRUB 2.14 reads btrfs with
# zstd compression (btrfs.mod contains grub_btrfs_zstd_decompress), so the
# compression does not get in the way.
#
# There is no swap partition: swap comes from zram in luna-base, which is faster and spares the disk.
set -eEuo pipefail

BACKTITLE="Luna Linux Installer"
# Our own palette instead of the standard blue one: dialog knows only eight
# basic colour names, but the terminal renders them with the Luna palette.
export DIALOGRC=${DIALOGRC:-/usr/share/luna/dialogrc}
LOG=/var/log/luna-install.log
REPO_DIR=/usr/share/luna/repo          # the local repository on the image

# The user's answers are collected here.
declare -A CFG=(
    [disk]="" [esp]="" [root]="" [scheme]=""
    [hostname]="luna" [user]="" [password]=""
    [timezone]="UTC" [keymap]="us" [kernel]="linux" [profile]="desktop"
    # [root] is what gets formatted and mounted; with encryption that is the
    # mapper device, while [rootpart] stays the physical partition the
    # bootloader has to be told to unlock.
    [rootpart]="" [encrypt]="no" [passphrase]=""
    [hibernate]="no" [swapsize]="" [resumeoffset]="" [initstyle]="udev"
)

log()  { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*" >> "$LOG"; }
die()  { dialog --backtitle "$BACKTITLE" --title "Error" --msgbox "$1" 10 64; exit 1; }

# A wrapper around dialog: one consistent style, and the text returned
# without stray quoting.
d() { dialog --backtitle "$BACKTITLE" --no-shadow "$@" 3>&1 1>&2 2>&3; }

# A yes/no dialog. The exit status has to be captured through "|| rc=$?",
# because under "set -e" a standalone failing command ends the script right
# there - which meant every Quit button used to kill the installer before its
# own cancel message could be printed.
ask() {
    local rc=0
    d "$@" || rc=$?
    return "$rc"
}

# Cancel on any screen means quitting, not falling through with an empty answer.
cancel_guard() {
    [[ $1 -eq 0 ]] && return 0
    clear
    echo "Installation cancelled."
    exit 1
}

require_root() {
    [[ $EUID -eq 0 ]] || { echo "luna-install must be run as root: sudo luna-install"; exit 1; }
}

is_uefi() { [[ -d /sys/firmware/efi/efivars ]]; }

# Two independent signs, because either can be missing on its own: a battery
# in /sys, and the chassis type the firmware reports through DMI. Used only to
# choose a sensible default, never to take a decision away from the user.
is_laptop() {
    compgen -G '/sys/class/power_supply/BAT*' >/dev/null 2>&1 && return 0
    local chassis
    chassis=$(hostnamectl chassis 2>/dev/null) || return 1
    [[ $chassis == laptop || $chassis == convertible || $chassis == tablet ]]
}

# Total RAM rounded up to whole gibibytes. Hibernation writes all of it, so
# the swap file cannot be smaller.
ram_gib() { awk '/^MemTotal:/ {printf "%d", ($2 + 1048575) / 1048576}' /proc/meminfo; }

#---------------------------------------------------------------------------
# Screens
#---------------------------------------------------------------------------

screen_welcome() {
    local mode; mode=$(is_uefi && echo "UEFI" || echo "BIOS / Legacy")
    ask --title "Welcome" --yes-label "Continue" --no-label "Quit" --yesno "\n\
Luna Linux installer.\n\n\
Firmware mode detected: ${mode}\n\n\
This will guide you through installing Luna onto a disk.\n\
Nothing is written until you confirm on the summary screen.\n" 14 64
    cancel_guard $?
}

# The installation downloads its packages, so without a network it cannot
# finish. This screen runs before the disk is touched: partitioning happens
# at 5% and pacstrap at 30%, so a missing connection used to leave an erased
# disk and a failure, which is the worst possible order of events.
have_network() {
    # Not a ping: ICMP is blocked on plenty of networks, while what pacstrap
    # actually needs is HTTPS to a mirror. Two addresses, so one of them
    # being down does not read as "no network".
    curl -fsS --max-time 8 -o /dev/null https://geo.mirror.pkgbuild.com/ 2>/dev/null && return 0
    curl -fsS --max-time 8 -o /dev/null https://archlinux.org/ 2>/dev/null
}

screen_network() {
    while ! have_network; do
        ask --title "No network" --yes-label "Connect" --no-label "Quit" \
            --yesno "\nLuna downloads its packages during the installation, so a network\nconnection is required.\n\nChoosing Connect opens the network manager. Wired connections usually\ncome up on their own; for Wi-Fi, pick the network and enter the password.\n\nNothing has been written to any disk yet." 15 72 || {
            clear
            echo "Installation cancelled: no network connection."
            exit 1
        }
        clear
        if command -v nmtui >/dev/null 2>&1; then
            nmtui connect || true
        elif command -v iwctl >/dev/null 2>&1; then
            iwctl
        else
            echo "Neither nmtui nor iwctl is available."; sleep 3
        fi
    done
}

screen_keymap() {
    local sel
    sel=$(d --title "Keyboard layout" --menu "\nConsole keymap:" 14 60 4 \
        us "US English" \
        us,ru "US + Russian" \
        de "German" \
        fr "French") || cancel_guard $?
    CFG[keymap]=$sel
}

screen_timezone() {
    local region city
    # UTC sits in the root of zoneinfo as a file rather than a directory, so it
    # never appears in the general list of regions; it is added as its own entry.
    # --no-tags removes the second column: in these menus the label equals the
    # value, and the duplication only cluttered the screen.
    region=$(d --title "Time zone" --no-tags --menu "\nRegion:" 18 60 8 \
        UTC "UTC (no local time zone)" \
        $(find /usr/share/zoneinfo -mindepth 1 -maxdepth 1 -type d -printf '%f %f\n' \
            | grep -vE '^(posix|right)' | sort)) || cancel_guard $?

    if [[ $region == UTC ]]; then
        CFG[timezone]=UTC
        return
    fi

    city=$(d --title "Time zone" --no-tags --menu "\nCity in ${region}:" 20 60 12 \
        $(find "/usr/share/zoneinfo/$region" -mindepth 1 -maxdepth 1 -printf '%f %f\n' | sort)) \
        || cancel_guard $?
    CFG[timezone]="$region/$city"
}

screen_disk() {
    local items=() name size model
    # Real disks only: no partitions, no CD-ROM and no loop devices of the image.
    while read -r name size model; do
        items+=("/dev/$name" "$size  ${model:-unknown}")
    done < <(lsblk -dpno NAME,SIZE,MODEL --nodeps 2>/dev/null \
             | sed 's|/dev/||' | grep -vE '^(loop|sr|ram)')

    [[ ${#items[@]} -gt 0 ]] || die "No disks found.\n\nIf this is a virtual machine, check that a disk is attached."

    CFG[disk]=$(d --title "Target disk" --menu "\nWhere should Luna be installed?" \
        16 70 6 "${items[@]}") || cancel_guard $?
}

screen_scheme() {
    CFG[scheme]=$(d --title "Partitioning" --menu "\nDisk: ${CFG[disk]}" 15 70 2 \
        auto   "Erase the whole disk and set it up automatically" \
        manual "Partition manually with cfdisk") || cancel_guard $?

    if [[ ${CFG[scheme]} == auto ]]; then
        ask --title "Confirm erase" --defaultno --yes-label "Erase" --no-label "Back" \
            --yesno "\nEVERYTHING on ${CFG[disk]} will be destroyed.\n\nContinue?" 10 60 \
            || { screen_scheme; return; }
    fi
}

# Manual partitioning: hand cfdisk to the user, then ask what is what.
screen_manual_partitions() {
    d --title "cfdisk" --msgbox "\n\
cfdisk will open now for ${CFG[disk]}.\n\n\
Create at least:\n\
  - an EFI System partition, 1 GiB (UEFI only)\n\
  - a partition for the system\n\n\
Remember to choose Write before quitting." 15 64
    clear
    cfdisk "${CFG[disk]}" || true
    partprobe "${CFG[disk]}" 2>/dev/null || true
    sleep 1

    local parts=() name size fstype
    while read -r name size fstype; do
        parts+=("$name" "$size  ${fstype:-no filesystem}")
    done < <(lsblk -pnlo NAME,SIZE,FSTYPE "${CFG[disk]}" | tail -n +2)

    [[ ${#parts[@]} -gt 0 ]] || die "No partitions found on ${CFG[disk]}."

    CFG[root]=$(d --title "Root partition" --menu "\nWhich partition should hold the system?\n\nIt will be formatted as btrfs." \
        18 70 6 "${parts[@]}") || cancel_guard $?

    if is_uefi; then
        CFG[esp]=$(d --title "EFI partition" --menu "\nWhich partition is the EFI System Partition?\n\nIt will be formatted as FAT32." \
            18 70 6 "${parts[@]}") || cancel_guard $?
        [[ ${CFG[esp]} != "${CFG[root]}" ]] || die "EFI and root cannot be the same partition."
    fi
}

# Disk encryption. Offered for the automatic layout only: with manual
# partitioning the user has already decided what goes where, and quietly
# wrapping one of their partitions in LUKS would be a surprise.
#
# The passphrase is never passed on a command line and never written to the
# log - cryptsetup reads it from standard input.
screen_encryption() {
    if [[ ${CFG[scheme]} != auto ]]; then
        CFG[encrypt]=no
        return 0
    fi
    ask --title "Disk encryption" --defaultno --yes-label "Encrypt" --no-label "No" \
        --yesno "\nEncrypt the whole disk with LUKS?\n\nEverything except the EFI partition is encrypted, the snapshots\nincluded. The passphrase is asked for once at every boot, before\nthe menu appears.\n\nWithout the passphrase the data cannot be recovered. There is no\nrecovery key and no way around it." 16 70 || { CFG[encrypt]=no; return 0; }
    CFG[encrypt]=yes
    local p1 p2
    while :; do
        p1=$(d --title "Disk passphrase" --insecure --passwordbox \
            "\nThis is asked at every boot:" 10 66) || cancel_guard $?
        p2=$(d --title "Disk passphrase" --insecure --passwordbox \
            "\nRepeat it:" 10 66) || cancel_guard $?
        [[ -n $p1 && $p1 == "$p2" ]] && break
        d --title "Try again" --msgbox \
            "\nThe passphrases do not match, or the first one was empty." 8 60
    done
    CFG[passphrase]=$p1
}

# Hibernation needs a swap file the size of physical RAM, because that is what
# gets written into it. zram already provides ordinary swap, so this is only
# about suspending to disk - which is why it is a question rather than a
# default: on a desktop with a lot of RAM it costs that much disk for
# something that may never be used. A machine with a battery gets Yes
# preselected, everything else gets No.
screen_hibernation() {
    CFG[swapsize]=$(ram_gib)
    local -a def=()
    is_laptop || def=(--defaultno)
    if ask --title "Hibernation" "${def[@]}" --yes-label "Enable" --no-label "Skip" \
            --yesno "\nSuspend to disk, so the machine can be powered off with the\nsession left open?\n\nIt needs a swap file of ${CFG[swapsize]} GiB, matching the physical\nmemory. The file lives in its own btrfs subvolume and is left out\nof the snapshots." 14 70; then
        CFG[hibernate]=yes
    else
        CFG[hibernate]=no
    fi
}

screen_hostname() {
    while :; do
        CFG[hostname]=$(d --title "Host name" --inputbox "\nName for this machine on the network:" \
            10 60 "${CFG[hostname]}") || cancel_guard $?
        [[ ${CFG[hostname]} =~ ^[a-z][a-z0-9-]{0,62}$ ]] && break
        d --title "Host name" --msgbox "\nUse lowercase letters, digits and dashes.\nMust start with a letter." 9 60
    done
}

screen_user() {
    while :; do
        CFG[user]=$(d --title "User account" --inputbox "\nYour login name:" 10 60 "${CFG[user]}") \
            || cancel_guard $?
        if [[ ! ${CFG[user]} =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
            d --title "User account" --msgbox "\nUse lowercase letters, digits, dash and underscore.\nMust start with a letter." 9 62
            continue
        fi
        break
    done

    while :; do
        local p1 p2
        p1=$(d --title "Password" --insecure --passwordbox "\nPassword for ${CFG[user]}:" 10 60) \
            || cancel_guard $?
        p2=$(d --title "Password" --insecure --passwordbox "\nRepeat the password:" 10 60) \
            || cancel_guard $?
        if [[ -z $p1 ]]; then
            d --title "Password" --msgbox "\nThe password cannot be empty." 8 50; continue
        fi
        if [[ $p1 != "$p2" ]]; then
            d --title "Password" --msgbox "\nThe passwords do not match." 8 50; continue
        fi
        CFG[password]=$p1
        break
    done
}

screen_kernel() {
    CFG[kernel]=$(d --title "Kernel" --menu "\nWhich kernel should Luna use?" 14 70 2 \
        linux     "Latest stable. Recommended." \
        linux-zen "Tuned for desktop responsiveness") || cancel_guard $?
}

screen_profile() {
    CFG[profile]=$(d --title "What to install" --menu "\nPackage selection:" 14 70 2 \
        desktop "Full Luna desktop: Hyprland, panel, apps" \
        minimal "Base system and command line only") || cancel_guard $?
}

screen_summary() {
    local mode; mode=$(is_uefi && echo UEFI || echo BIOS)
    local enc hib
    if [[ ${CFG[encrypt]} == yes ]]; then enc="LUKS, passphrase at every boot"
    else enc="none"; fi
    if [[ ${CFG[hibernate]} == yes ]]; then hib="swap file, ${CFG[swapsize]} GiB"
    else hib="no (zram swap only)"; fi
    local layout
    if [[ ${CFG[scheme]} == auto ]]; then
        layout="whole disk, erased"
    else
        layout="root ${CFG[root]}${CFG[esp]:+, EFI ${CFG[esp]}}"
    fi
    ask --title "Ready to install" --defaultno --yes-label "Install" --no-label "Cancel" --yesno "\n\
  Disk        ${CFG[disk]}\n\
  Layout      ${layout}\n\
  Firmware    ${mode}\n\
  Filesystem  btrfs with snapshots\n\
  Encryption  ${enc}\n\
  Hibernation ${hib}\n\
  Kernel      ${CFG[kernel]}\n\
  Packages    ${CFG[profile]}\n\
  Host name   ${CFG[hostname]}\n\
  User        ${CFG[user]}\n\
  Time zone   ${CFG[timezone]}\n\
  Keymap      ${CFG[keymap]}\n\n\
Writing starts now. Data on the disk will be lost.\n" 22 66
    cancel_guard $?
}

#---------------------------------------------------------------------------
# Installation
#---------------------------------------------------------------------------

FAILMARK=/run/luna-install.failed

# Failures that do not go through run() or runsh() still have to leave a trace.
# Without this, a function that returns non-zero ends the installation through
# errexit while main() finds no failure marker and reports success. That is not
# hypothetical: one line of the form
#
#     [[ ${CFG[encrypt]} == yes ]] && runsh "chmod ..."
#
# sat at the end of do_configure, and on an unencrypted install it made the
# function return 1. The installation stopped before the bootloader, said
# nothing, and left a disk with an empty EFI partition.
on_error() {
    local rc=$1 line=$2
    log "UNEXPECTED FAILURE: exit $rc at line $line"
    [[ -f $FAILMARK ]] || echo "unexpected error at line $line (exit $rc)" > "$FAILMARK"
}
trap 'on_error $? $LINENO' ERR

# Any failed command stops the installation and leaves a clear trace in the log.
# Inside the gauge pipeline an ordinary set -e would not fire.
run() {
    log "RUN: $*"
    if ! "$@" >>"$LOG" 2>&1; then
        log "FAILED: $*"
        printf '%s\n' "$*" > "$FAILMARK"
        exit 1
    fi
}

# The same, but for a string that has to be run by a shell.
runsh() {
    log "SH: $1"
    if ! bash -c "$1" >>"$LOG" 2>&1; then
        log "FAILED: $1"
        printf '%s\n' "$1" > "$FAILMARK"
        exit 1
    fi
}

step() { printf 'XXX\n%s\n%s\nXXX\n' "$1" "$2"; }

# nvme0n1 + 1 -> nvme0n1p1, sda + 1 -> sda1
part_of() { [[ $1 =~ [0-9]$ ]] && echo "${1}p${2}" || echo "${1}${2}"; }

do_partition() {
    [[ ${CFG[scheme]} == auto ]] || return 0
    local d=${CFG[disk]}
    run sgdisk --zap-all "$d"
    run wipefs -a "$d"
    if is_uefi; then
        run sgdisk -n 1:0:+1G -t 1:ef00 -c 1:"EFI System" "$d"
        run sgdisk -n 2:0:0    -t 2:8304 -c 2:"Luna root" "$d"
        CFG[esp]=$(part_of "$d" 1)
        CFG[rootpart]=$(part_of "$d" 2)
    else
        # GPT + GRUB on BIOS needs a separate partition for the bootloader image.
        run sgdisk -n 1:0:+1M -t 1:ef02 -c 1:"BIOS boot" "$d"
        run sgdisk -n 2:0:0    -t 2:8304 -c 2:"Luna root" "$d"
        CFG[rootpart]=$(part_of "$d" 2)
    fi
    run partprobe "$d"
    sleep 2
    do_encrypt
}

# The LUKS container, when encryption was chosen. Everything below works on
# CFG[root] afterwards and does not care whether that is a partition or a
# mapper device.
#
# The passphrase goes in through standard input: an argument would show up in
# the process list and in the log this installer keeps.
do_encrypt() {
    if [[ ${CFG[encrypt]} != yes ]]; then
        CFG[root]=${CFG[rootpart]}
        return 0
    fi
    log "RUN: cryptsetup luksFormat ${CFG[rootpart]} (passphrase from stdin)"
    if ! printf '%s' "${CFG[passphrase]}" | cryptsetup luksFormat --type luks2 --batch-mode --key-file - "${CFG[rootpart]}" >>"$LOG" 2>&1; then
        log "FAILED: cryptsetup luksFormat"
        echo 'cryptsetup luksFormat' > "$FAILMARK"
        exit 1
    fi
    log "RUN: cryptsetup open ${CFG[rootpart]} luna"
    if ! printf '%s' "${CFG[passphrase]}" | cryptsetup open --key-file - "${CFG[rootpart]}" luna >>"$LOG" 2>&1; then
        log "FAILED: cryptsetup open"
        echo 'cryptsetup open' > "$FAILMARK"
        exit 1
    fi
    CFG[root]=/dev/mapper/luna
}

do_format() {
    # Manual partitioning fills in CFG[root] directly and never encrypts, so
    # the two names have to be brought back together here.
    [[ -n ${CFG[rootpart]} ]] || CFG[rootpart]=${CFG[root]}

    [[ -n ${CFG[esp]} ]] && run mkfs.fat -F32 -n LUNA_EFI "${CFG[esp]}"
    run mkfs.btrfs -f -L Luna "${CFG[root]}"

    # The subvolumes are created on the bare root, then remounted by subvol.
    run mount "${CFG[root]}" /mnt
    local -a subvols=(@ @home @snapshots @log @pkg)
    # The swap file lives in its own subvolume so that it stays out of the
    # snapshots: a snapshot of a swap file is both useless and large.
    [[ ${CFG[hibernate]} == yes ]] && subvols+=(@swap)
    local sv
    for sv in "${subvols[@]}"; do
        run btrfs subvolume create "/mnt/$sv"
    done
    run umount /mnt
}

do_mount() {
    # compress=zstd:3 saves a noticeable amount of space at almost no CPU cost.
    # noatime removes an access-time write on every read.
    local o="noatime,compress=zstd:3"
    run mount -o "$o,subvol=@" "${CFG[root]}" /mnt
    run mkdir -p /mnt/{home,.snapshots,var/log,var/cache/pacman/pkg,efi}
    run mount -o "$o,subvol=@home"      "${CFG[root]}" /mnt/home
    run mount -o "$o,subvol=@snapshots" "${CFG[root]}" /mnt/.snapshots
    run mount -o "$o,subvol=@log"       "${CFG[root]}" /mnt/var/log
    run mount -o "$o,subvol=@pkg"       "${CFG[root]}" /mnt/var/cache/pacman/pkg
    [[ -n ${CFG[esp]} ]] && run mount "${CFG[esp]}" /mnt/efi

    if [[ ${CFG[hibernate]} == yes ]]; then
        # No compression on this one. A swap file has to be a plain run of
        # blocks the kernel can address directly, which is also why
        # mkswapfile marks it nodatacow for us.
        run mkdir -p /mnt/swap
        run mount -o "noatime,subvol=@swap" "${CFG[root]}" /mnt/swap
        run btrfs filesystem mkswapfile --size "${CFG[swapsize]}g" /mnt/swap/swapfile
        run swapon /mnt/swap/swapfile
        # The kernel resumes from a block offset, not from a path, so the
        # offset has to be read now and put on the kernel command line later.
        CFG[resumeoffset]=$(btrfs inspect-internal map-swapfile -r /mnt/swap/swapfile)
        log "swap file offset: ${CFG[resumeoffset]}"
    fi
    return 0
}

do_pacstrap() {
    local pkgs=(base "${CFG[kernel]}" "${CFG[kernel]}-headers"
                luna-keyring luna-release luna-base luna-cli)
    [[ ${CFG[profile]} == desktop ]] && pkgs+=(luna-desktop)
    # The encrypt hook of mkinitcpio comes from cryptsetup, and without it on
    # the target the initramfs cannot open the container it just created.
    [[ ${CFG[encrypt]} == yes ]] && pkgs+=(cryptsetup)

    # The microcode matches the actual CPU vendor: the other one would merely
    # take up space and confuse the bootloader output.
    if grep -qi 'GenuineIntel' /proc/cpuinfo; then pkgs+=(intel-ucode)
    elif grep -qi 'AuthenticAMD' /proc/cpuinfo; then pkgs+=(amd-ucode); fi

    log "pacstrap packages: ${pkgs[*]}"
    run pacstrap -K -C /etc/pacman.conf /mnt "${pkgs[@]}"

    # The Luna key in the target keyring. The luna-keyring scriptlet has done
    # this already, but only if pacman-key had appeared in /mnt by the time it
    # ran. The order of packages within a single transaction is not ours to
    # control, so we repeat it explicitly - pacman-key --populate is
    # idempotent and an extra run spoils nothing.
    if [[ -f /mnt/usr/share/pacman/keyrings/luna.gpg ]]; then
        run arch-chroot /mnt pacman-key --populate luna
    fi
}

do_configure() {
    runsh "genfstab -U /mnt >> /mnt/etc/fstab"

    run arch-chroot /mnt ln -sf "/usr/share/zoneinfo/${CFG[timezone]}" /etc/localtime
    run arch-chroot /mnt hwclock --systohc

    # Locale: luna-release already enables en_US.UTF-8; this is a safety net.
    runsh "sed -i 's/^#\(en_US\.UTF-8 UTF-8\)/\1/' /mnt/etc/locale.gen"
    run arch-chroot /mnt locale-gen
    runsh "echo 'LANG=en_US.UTF-8' > /mnt/etc/locale.conf"
    runsh "echo 'KEYMAP=${CFG[keymap]}' > /mnt/etc/vconsole.conf"

    runsh "echo '${CFG[hostname]}' > /mnt/etc/hostname"
    runsh "printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s.localdomain %s\n' '${CFG[hostname]}' '${CFG[hostname]}' > /mnt/etc/hosts"

    # The user. The fish shell comes from luna-cli together with its settings
    # in /etc/skel, so useradd -m yields a ready environment straight away.
    run arch-chroot /mnt useradd -m -G wheel -s /usr/bin/fish "${CFG[user]}"
    printf '%s:%s\n' "${CFG[user]}" "${CFG[password]}" | arch-chroot /mnt chpasswd \
        || { printf 'chpasswd\n' > "$FAILMARK"; exit 1; }

    # Root is locked: the way in is sudo only. If sudo ever breaks, booting
    # from this same image is the way out, whereas a permanently open root is
    # extra surface for mistakes.
    run arch-chroot /mnt passwd -l root
    runsh "echo '%wheel ALL=(ALL:ALL) ALL' > /mnt/etc/sudoers.d/10-wheel"
    run chmod 0440 /mnt/etc/sudoers.d/10-wheel

    # The pacman details that cannot be shipped in a package: /etc/pacman.conf
    # belongs to pacman itself and supports no drop-in sections.
    runsh "sed -i 's/^#Color\$/Color/;s/^#VerbosePkgLists\$/VerbosePkgLists/' /mnt/etc/pacman.conf"
    runsh "grep -q '^ParallelDownloads' /mnt/etc/pacman.conf || sed -i 's/^#ParallelDownloads.*/ParallelDownloads = 5/' /mnt/etc/pacman.conf"

    # The local repository moves onto the installed system: otherwise the
    # luna-* packages would be left without a source of updates. A temporary
    # measure until there is a real repository on the network.
    if [[ -d $REPO_DIR ]]; then
        run mkdir -p /mnt"$REPO_DIR"
        runsh "cp -a '$REPO_DIR'/. /mnt'$REPO_DIR'/"
        runsh "printf '\n[luna]\nSigLevel = Required DatabaseOptional\nServer = file://%s\n' '$REPO_DIR' >> /mnt/etc/pacman.conf"
    fi

    # mkinitcpio has two styles of hooks, the older udev one and the systemd
    # one that is now the default, and they use different names for the same
    # jobs. The style is read out of the file rather than assumed.
    #
    # This is not caution for its own sake. The previous version of this code
    # edited "HOOKS=(base udev " - a line that stopped existing when the
    # default changed - so the plymouth hook silently never made it into the
    # initramfs, and nobody noticed, because a sed that matches nothing says
    # nothing. The check at the end of this block exists for the same reason.
    if grep -qE '^HOOKS=\(base +systemd' /mnt/etc/mkinitcpio.conf; then
        CFG[initstyle]=systemd
    fi
    log "initramfs style: ${CFG[initstyle]}"

    # The plymouth splash has to come right after the hook that sets up the
    # console, before kernel output starts pouring onto the screen.
    if [[ ${CFG[initstyle]} == systemd ]]; then
    runsh "sed -i '/^HOOKS=/ s/ systemd / systemd plymouth /' /mnt/etc/mkinitcpio.conf"
    else
    runsh "sed -i '/^HOOKS=/ s/ udev / udev plymouth /' /mnt/etc/mkinitcpio.conf"
    fi
    # Booting into a snapshot without grub-btrfs-overlayfs gives a read-only
    # system; overlayfs makes it usable for repairs. It goes last.
    runsh "sed -i '/^HOOKS=/ s/)$/ grub-btrfs-overlayfs)/' /mnt/etc/mkinitcpio.conf"

    if [[ ${CFG[encrypt]} == yes ]]; then
        # Unlocking after block, when the device exists, and before the root
        # filesystem is needed. sd-encrypt is the systemd counterpart of
        # encrypt; putting the wrong one in leaves the initramfs waiting for
        # a mapper device that nothing ever creates.
        if [[ ${CFG[initstyle]} == systemd ]]; then
    runsh "sed -i '/^HOOKS=/ s/ block / block sd-encrypt /' /mnt/etc/mkinitcpio.conf"
        else
    runsh "sed -i '/^HOOKS=/ s/ block / block encrypt /' /mnt/etc/mkinitcpio.conf"
        fi
    fi
    # Resuming from hibernation needs a hook only in the udev style; systemd
    # does it from the resume= kernel parameter on its own.
    if [[ ${CFG[hibernate]} == yes && ${CFG[initstyle]} == udev ]]; then
    runsh "sed -i '/^HOOKS=/ s/ filesystems / filesystems resume /' /mnt/etc/mkinitcpio.conf"
    fi

    # A key file baked into the initramfs, so the passphrase is typed once
    # instead of twice: GRUB asks for it to read /boot, and without this the
    # initramfs would ask again for the same container.
    #
    # It is safe here only because /boot is itself inside the encrypted
    # volume, so the initramfs holding the key is encrypted too. With an
    # unencrypted /boot this would hand the disk away.
    if [[ ${CFG[encrypt]} == yes ]]; then
        run dd if=/dev/urandom of=/mnt/crypto_keyfile.bin bs=512 count=4 status=none
        run chmod 600 /mnt/crypto_keyfile.bin
        log "RUN: cryptsetup luksAddKey (key file)"
        if ! printf '%s' "${CFG[passphrase]}" | arch-chroot /mnt cryptsetup luksAddKey --key-file - "${CFG[rootpart]}" /crypto_keyfile.bin >>"$LOG" 2>&1; then
            log "FAILED: cryptsetup luksAddKey"
            echo 'cryptsetup luksAddKey' > "$FAILMARK"
            exit 1
        fi
    runsh "sed -i 's|^FILES=.*|FILES=(/crypto_keyfile.bin)|' /mnt/etc/mkinitcpio.conf"

        # In the systemd style the unlocking is described by /etc/crypttab,
        # not by kernel parameters. x-initrd.attach is what makes sd-encrypt
        # copy the line into the initramfs.
        if [[ ${CFG[initstyle]} == systemd ]]; then
            local luksuuid
            luksuuid=$(blkid -s UUID -o value "${CFG[rootpart]}")
            printf 'luna UUID=%s /crypto_keyfile.bin x-initrd.attach\n' "$luksuuid" >> /mnt/etc/crypttab
            log "crypttab: luna UUID=$luksuuid"
        fi
    fi

    # Verify rather than hope. Every hook that was supposed to be added is
    # checked for, and a missing one stops the installation with a clear
    # reason instead of producing a system that will not boot.
    local hooks
    hooks=$(grep '^HOOKS=' /mnt/etc/mkinitcpio.conf)
    local -a want=(plymouth grub-btrfs-overlayfs)
    if [[ ${CFG[encrypt]} == yes ]]; then
        if [[ ${CFG[initstyle]} == systemd ]]; then want+=(sd-encrypt); else want+=(encrypt); fi
    fi
    if [[ ${CFG[hibernate]} == yes && ${CFG[initstyle]} == udev ]]; then want+=(resume); fi
    local h
    for h in "${want[@]}"; do
        if [[ $hooks != *" $h"* ]]; then
            log "FAILED: hook $h is missing from: $hooks"
            echo "mkinitcpio hook missing: $h" > "$FAILMARK"
            exit 1
        fi
    done
    log "hooks: $hooks"
    run arch-chroot /mnt mkinitcpio -P
    # The generated initramfs carries the key file. /boot is inside the
    # encrypted volume, so it is not exposed at rest, but there is no reason
    # for it to be readable by everyone on a running system either.
    if [[ ${CFG[encrypt]} == yes ]]; then
        runsh "chmod 600 /mnt/boot/initramfs-*.img"
    fi
}

do_bootloader() {
    # With /boot inside the encrypted volume, GRUB has to open the container
    # itself in order to read the kernel. It only does that when told to, and
    # it has to be told before grub-install, which is when the modules are
    # chosen and embedded.
    if [[ ${CFG[encrypt]} == yes ]]; then
        runsh "grep -q '^GRUB_ENABLE_CRYPTODISK=' /mnt/etc/default/grub || echo 'GRUB_ENABLE_CRYPTODISK=y' >> /mnt/etc/default/grub"
    fi
    if is_uefi; then
        run arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/efi \
            --bootloader-id=Luna --recheck
    else
        run arch-chroot /mnt grub-install --target=i386-pc --recheck "${CFG[disk]}"
    fi

    # The look of the bootloader menu. /etc/default/grub belongs to the grub
    # package and supports no drop-in sections, so it is edited here rather
    # than shipped in a package. With a background set, GRUB treats black as
    # transparent, so the text lands directly on the splash image.
    runsh "sed -i 's|^GRUB_DISTRIBUTOR=.*|GRUB_DISTRIBUTOR=\"Luna\"|' /mnt/etc/default/grub"
    runsh "sed -i 's|^#\?GRUB_GFXMODE=.*|GRUB_GFXMODE=auto|' /mnt/etc/default/grub"
    runsh "grep -q '^GRUB_BACKGROUND=' /mnt/etc/default/grub || printf '\nGRUB_BACKGROUND=\"/usr/share/luna/grub-background.png\"\nGRUB_COLOR_NORMAL=\"light-gray/black\"\nGRUB_COLOR_HIGHLIGHT=\"light-magenta/black\"\n' >> /mnt/etc/default/grub"

    # splash turns the plymouth screen on. It is appended before the closing
    # quote so that whatever is already there survives (Arch defaults to
    # loglevel=3 quiet, without which kernel output would cover the splash).
    runsh "grep -q splash /mnt/etc/default/grub || sed -i '/^GRUB_CMDLINE_LINUX_DEFAULT=/ s/\"\$/ splash\"/' /mnt/etc/default/grub"

    # Kernel parameters for the two optional features. GRUB_CMDLINE_LINUX
    # applies to every menu entry, snapshots included, and a second
    # assignment is enough: the file is sourced, so the last one wins and
    # whatever Arch put in the first is left alone.
    local -a extra=()
    # Only the udev style needs the container described on the kernel command
    # line. In the systemd style /etc/crypttab does that job, and grub-mkconfig
    # writes root= from the mounted filesystem by itself.
    if [[ ${CFG[encrypt]} == yes && ${CFG[initstyle]} == udev ]]; then
        local luksuuid
        luksuuid=$(blkid -s UUID -o value "${CFG[rootpart]}")
        extra+=("cryptdevice=UUID=${luksuuid}:luna" "root=/dev/mapper/luna"
                "cryptkey=rootfs:/crypto_keyfile.bin")
    fi
    if [[ ${CFG[hibernate]} == yes ]]; then
        local fsuuid
        fsuuid=$(blkid -s UUID -o value "${CFG[root]}")
        extra+=("resume=UUID=${fsuuid}" "resume_offset=${CFG[resumeoffset]}")
    fi
    if (( ${#extra[@]} )); then
        printf '\nGRUB_CMDLINE_LINUX="%s"\n' "${extra[*]}" >> /mnt/etc/default/grub
        log "kernel cmdline additions: ${extra[*]}"
    fi

    run arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg
}

do_snapper() {
    # On create-config snapper makes a /.snapshots subvolume of its own, and we
    # already have @snapshots mounted there. So: let it create the config,
    # remove its subvolume and put ours back.
    run umount /mnt/.snapshots
    run rmdir /mnt/.snapshots
    run arch-chroot /mnt snapper --no-dbus -c root create-config /
    run arch-chroot /mnt btrfs subvolume delete /.snapshots
    run mkdir -p /mnt/.snapshots
    run mount -o "noatime,compress=zstd:3,subvol=@snapshots" "${CFG[root]}" /mnt/.snapshots
    run arch-chroot /mnt chmod 750 /.snapshots

    # Sensible limits: without them snapshots quietly eat the disk.
    runsh "arch-chroot /mnt sed -i 's/^TIMELINE_LIMIT_HOURLY=.*/TIMELINE_LIMIT_HOURLY=\"5\"/;s/^TIMELINE_LIMIT_DAILY=.*/TIMELINE_LIMIT_DAILY=\"7\"/;s/^TIMELINE_LIMIT_WEEKLY=.*/TIMELINE_LIMIT_WEEKLY=\"2\"/;s/^TIMELINE_LIMIT_MONTHLY=.*/TIMELINE_LIMIT_MONTHLY=\"0\"/;s/^TIMELINE_LIMIT_YEARLY=.*/TIMELINE_LIMIT_YEARLY=\"0\"/' /etc/snapper/configs/root"

    # The rollback entries in the GRUB menu appear after this.
    run arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg
}

do_services() {
    # The set of services is defined by the presets from luna-base and
    # luna-desktop, and preset-all is what applies them, instead of a scatter
    # of systemctl enable calls.
    run arch-chroot /mnt systemctl preset-all
}

install_all() {
    rm -f "$FAILMARK"
    step 5  "Partitioning ${CFG[disk]}"
    do_partition
    step 15 "Creating filesystems"
    do_format
    step 22 "Mounting subvolumes"
    do_mount
    step 30 "Installing packages. This is the long part."
    do_pacstrap
    step 70 "Configuring the system"
    do_configure
    step 85 "Installing the bootloader"
    do_bootloader
    step 92 "Setting up snapshots"
    do_snapper
    step 97 "Enabling services"
    do_services
    step 100 "Done"
    sleep 1
}

#---------------------------------------------------------------------------
# Main sequence
#---------------------------------------------------------------------------

main() {
    require_root
    : > "$LOG"
    log "luna-install started"

    screen_welcome
    screen_network
    screen_keymap
    loadkeys "${CFG[keymap]%%,*}" 2>/dev/null || true
    screen_timezone
    screen_disk
    screen_scheme
    [[ ${CFG[scheme]} == manual ]] && screen_manual_partitions
    screen_encryption
    screen_hibernation
    screen_hostname
    screen_user
    screen_kernel
    screen_profile
    screen_summary

    install_all | dialog --backtitle "$BACKTITLE" --title "Installing Luna" \
        --gauge "\nPreparing..." 10 70 0

    if [[ -f $FAILMARK ]]; then
        local what; what=$(cat "$FAILMARK")
        d --title "Installation failed" --msgbox "\n\
The step below did not finish:\n\n  ${what}\n\n\
The full log is at ${LOG}\n\
Nothing was changed after that point." 14 68
        clear
        echo "Installation failed. See $LOG"
        tail -n 20 "$LOG"
        exit 1
    fi

    ask --title "Installation complete" --yes-label "Reboot" --no-label "Stay here" --yesno "\n\
Luna Linux is installed on ${CFG[disk]}.\n\n\
On the next boot you will be greeted by the login screen.\n\
Log in as ${CFG[user]}.\n\n\
Remove the installation medium before rebooting.\n\n\
Reboot now?" 16 66

    if [[ $? -eq 0 ]]; then
        clear
        umount -R /mnt 2>/dev/null || true
        systemctl reboot
    else
        clear
        echo "Luna is installed. The target is still mounted at /mnt."
        echo "Log: $LOG"
    fi
}

main "$@"
