# The colour scheme of the Luna installer.
#
# dialog knows only the eight basic colour names, but the terminal renders
# them with its own palette. Kitty in Luna is set up so that MAGENTA is the
# lavender #b4a0ff, CYAN is the light blue #8bd5ff and BLACK is the dark
# backdrop #1b1926. The basic names are therefore enough to make the
# installer look like part of the system rather than a piece of somebody
# else's interface.
#
# The ON flag turns on the bright variant of a colour (the second row of the palette).

use_shadow = OFF
use_colors = ON
use_scrollbar = ON

# The background behind the windows is dark, instead of the standard bright blue.
screen_color = (BLACK,BLACK,OFF)
shadow_color = (BLACK,BLACK,OFF)

dialog_color = (WHITE,BLACK,OFF)
title_color  = (MAGENTA,BLACK,ON)
border_color  = (BLACK,BLACK,ON)
border2_color = (BLACK,BLACK,ON)

# The active button gets a lavender fill, like the active workspace in the panel.
button_active_color         = (BLACK,MAGENTA,ON)
button_inactive_color       = (WHITE,BLACK,OFF)
button_key_active_color     = (BLACK,MAGENTA,ON)
button_key_inactive_color   = (CYAN,BLACK,OFF)
button_label_active_color   = (BLACK,MAGENTA,ON)
button_label_inactive_color = (WHITE,BLACK,OFF)

inputbox_color        = dialog_color
inputbox_border_color = (BLACK,BLACK,ON)
menubox_color         = dialog_color
menubox_border_color  = (BLACK,BLACK,ON)

item_color          = (WHITE,BLACK,OFF)
item_selected_color = (BLACK,MAGENTA,ON)
tag_color           = (CYAN,BLACK,OFF)
tag_selected_color  = (BLACK,MAGENTA,ON)
tag_key_color          = (CYAN,BLACK,OFF)
tag_key_selected_color = (BLACK,MAGENTA,ON)

position_indicator_color = (CYAN,BLACK,OFF)
uarrow_color = (CYAN,BLACK,OFF)
darrow_color = (CYAN,BLACK,OFF)
itemhelp_color = (CYAN,BLACK,OFF)

searchbox_color        = dialog_color
searchbox_title_color  = title_color
searchbox_border_color = (BLACK,BLACK,ON)

check_color          = dialog_color
check_selected_color = (BLACK,MAGENTA,ON)

form_active_text_color  = (BLACK,MAGENTA,ON)
form_text_color         = (WHITE,BLACK,OFF)
form_item_readonly_color = (CYAN,BLACK,OFF)

gauge_color = (MAGENTA,BLACK,ON)
