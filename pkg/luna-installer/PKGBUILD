# Maintainer: Luna Linux
pkgname=luna-installer
pkgver=0.1.0
pkgrel=1
pkgdesc="The Luna Linux installer with a text user interface"
arch=('any')
url="https://github.com/luna-linux"
license=('GPL-3.0-or-later')

depends=($(grep -vE '^[[:space:]]*(#|$)' "$startdir/depends.txt" | awk '{print $1}'))

source=('luna-install'
        'luna-install.desktop'
        'dialogrc')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "$srcdir/luna-install" "$pkgdir/usr/bin/luna-install"

  # The desktop entry is there so the installer can be found through the
  # launcher (Super+R) and not only by remembering the command name.
  install -Dm644 "$srcdir/luna-install.desktop" \
    "$pkgdir/usr/share/applications/luna-install.desktop"

  # The dialog palette: without it the installer looks like a standard blue
  # box with nothing in common with the rest of the system.
  install -Dm644 "$srcdir/dialogrc" "$pkgdir/usr/share/luna/dialogrc"
}
