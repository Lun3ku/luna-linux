# Maintainer: Luna Linux
pkgname=luna-release
pkgver=0.1.0
pkgrel=1
pkgdesc="Luna Linux system identity"
arch=('any')
url="https://github.com/luna-linux"
license=('GPL-3.0-or-later')

# It deliberately depends on nothing: this package has to fit on the boot image
# too, where a compiler and snapshots are of no use. All the heavy base is
# pulled in by luna-base, which depends on this package.
depends=()

install="$pkgname.install"
source=('os-release-luna')
sha256sums=('SKIP')

package() {
  install -Dm644 "$srcdir/os-release-luna" "$pkgdir/usr/lib/os-release-luna"
}
