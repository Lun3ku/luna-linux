# Maintainer: Luna Linux
pkgname=luna-release
pkgver=0.1.0
pkgrel=1
pkgdesc="Идентификация системы Luna Linux"
arch=('any')
url="https://github.com/luna-linux"
license=('GPL-3.0-or-later')

# Ни от чего не зависит сознательно: этот пакет должен попадать и на
# загрузочный образ, где компилятор и снапшоты не нужны. Всю тяжёлую
# базу тянет luna-base, который зависит от этого пакета.
depends=()

install="$pkgname.install"
source=('os-release-luna')
sha256sums=('SKIP')

package() {
  install -Dm644 "$srcdir/os-release-luna" "$pkgdir/usr/lib/os-release-luna"
}
