# /etc/os-release is a symlink that belongs to no package (/usr/lib/os-release
# is owned by the filesystem package). So our own file is placed next to it as
# os-release-luna and the symlink is repointed, which keeps pacman from
# complaining about a file conflict.
#
# This also fixes the login greeting: /etc/issue contains \S{PRETTY_NAME}, that
# is, it takes the system name straight out of os-release.

_link_os_release() {
  ln -sfn /usr/lib/os-release-luna /etc/os-release
}

# Luna is English-speaking and needs a generated en_US.UTF-8.
#
# Without it the system is left with nothing but C/C.utf8/POSIX, and that
# breaks more than it seems: the waybar clock module switches itself off with
# "locale::facet::_S_create_c_locale name not valid", and sorting and date
# formatting break too.
#
# Editing /etc/locale.gen is the only dependable way: glibc has no drop-in
# mechanism, and locales created directly with localedef are wiped by the next
# locale-gen. The file is marked as backup by glibc, so our edit survives
# updates.
_ensure_locale() {
  if locale -a 2>/dev/null | grep -qix 'en_US.utf8'; then
    return
  fi
  if [ -f /etc/locale.gen ]; then
    sed -i 's/^#\(en_US\.UTF-8 UTF-8\)/\1/' /etc/locale.gen
    locale-gen >/dev/null 2>&1 || true
  fi
}

post_install() {
  _link_os_release
  _ensure_locale
}

post_upgrade() {
  _link_os_release
  _ensure_locale
}

pre_remove() {
  # Put Arch's own symlink back, otherwise the system is left with no
  # os-release at all.
  ln -sfn ../usr/lib/os-release /etc/os-release
}
