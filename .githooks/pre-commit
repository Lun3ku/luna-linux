#!/usr/bin/env bash
# Защита от порчи символических ссылок при коммите из Windows.
#
# В профиле archiso 36 символических ссылок — именно ими включаются
# сервисы. Git для Windows прочитать их не может (их создал WSL, и для
# Windows это непрозрачные точки повторного разбора), поэтому коммит
# оттуда молча превратит ссылки в текстовые файлы с путём внутри.
# Собранный образ после этого загрузится, но без сети, звука и половины
# системы — и причину искать будет негде.
#
# Поэтому: коммитить этот репозиторий нужно из WSL.
#     wsl -d LunaBuild -u root -- git -C "<путь>" commit
set -euo pipefail

# Пути, которые в последнем коммите были ссылками (режим 120000).
mapfile -t was_link < <(git ls-tree -r HEAD 2>/dev/null | awk '$1=="120000"{print $4}')
[[ ${#was_link[@]} -eq 0 ]] && exit 0

broken=()
for p in "${was_link[@]}"; do
    mode=$(git ls-files -s -- "$p" | awk '{print $1}')
    [[ -n $mode && $mode != 120000 ]] && broken+=("$p")
done

if (( ${#broken[@]} )); then
    printf '\n\033[1;31mКоммит остановлен.\033[0m\n\n' >&2
    printf 'Символические ссылки превращаются в обычные файлы (%d шт.), например:\n' "${#broken[@]}" >&2
    printf '  %s\n' "${broken[@]:0:5}" >&2
    printf '\nТак бывает при коммите из Windows: его git эти ссылки не читает.\n' >&2
    printf 'Коммить из WSL:\n\n' >&2
    printf '  wsl -d LunaBuild -u root -- git -C "%s" commit\n\n' "$(pwd)" >&2
    exit 1
fi
