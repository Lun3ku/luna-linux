#!/usr/bin/env bash
# Guards against symlinks being destroyed by a commit made from Windows.
#
# The archiso profile contains 36 symbolic links, and they are what enables
# the services. Git for Windows cannot read them (they were created by WSL,
# and to Windows they are opaque reparse points), so a commit from there
# silently turns the links into text files containing a path. An image built
# afterwards still boots, but without networking, without sound and without
# half the system, and there is nothing left to trace the cause to.
#
# Hence: this repository must be committed from WSL.
#     wsl -d LunaBuild -u root -- git -C "<path>" commit
set -euo pipefail

# Paths that were symlinks (mode 120000) in the last commit.
mapfile -t was_link < <(git ls-tree -r HEAD 2>/dev/null | awk '$1=="120000"{print $4}')
[[ ${#was_link[@]} -eq 0 ]] && exit 0

broken=()
for p in "${was_link[@]}"; do
    mode=$(git ls-files -s -- "$p" | awk '{print $1}')
    [[ -n $mode && $mode != 120000 ]] && broken+=("$p")
done

if (( ${#broken[@]} )); then
    printf '\n\033[1;31mCommit stopped.\033[0m\n\n' >&2
    printf 'Symbolic links are being turned into regular files (%d of them), for example:\n' "${#broken[@]}" >&2
    printf '  %s\n' "${broken[@]:0:5}" >&2
    printf '\nThis is what a commit from Windows does: its git cannot read these links.\n' >&2
    printf 'Commit from WSL instead:\n\n' >&2
    printf '  wsl -d LunaBuild -u root -- git -C "%s" commit\n\n' "$(pwd)" >&2
    exit 1
fi
