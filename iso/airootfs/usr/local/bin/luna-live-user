#!/usr/bin/env bash
# Создаёт пользователя живого образа Luna.
#
# Делается явным сервисом, а не файлом в sysusers.d, по двум причинам:
#   1. Пользователей при сборке образа создаёт pacman-хук, а оверлей airootfs
#      копируется уже после установки пакетов — то есть наш файл хук не увидит.
#   2. systemd-sysusers.service помечен ConditionNeedsUpdate=|/etc и при
#      загрузке может не запуститься вовсе.
# А без этого пользователя не будет рабочего стола: Hyprland отказывается
# работать от root.
set -euo pipefail

USER_NAME=luna
# uucp даёт доступ к /dev/ttyS0 — через него вывод команд можно поймать
# на хосте (см. --serial в scripts/test-iso.sh). На живом образе это
# удобно для отладки и ничем не грозит.
USER_GROUPS=wheel,video,input,audio,storage,optical,uucp

if ! id -u "$USER_NAME" >/dev/null 2>&1; then
  useradd -m -G "$USER_GROUPS" -s /usr/bin/fish -c "Luna Live" "$USER_NAME"
  # Живой образ — пароля нет. На установленной системе пароль задаёт установщик.
  passwd -d "$USER_NAME" >/dev/null
fi

# useradd копирует /etc/skel сам, но если домашний каталог уже был создан
# раньше (например, повторный запуск), конфиги могли не попасть.
if [[ ! -e /home/$USER_NAME/.config/hypr/hyprland.lua ]]; then
  cp -rT /etc/skel "/home/$USER_NAME"
  chown -R "$USER_NAME:$USER_NAME" "/home/$USER_NAME"
fi
