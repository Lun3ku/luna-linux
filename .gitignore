# Built packages and the repository are build output, not sources.
# The real repository lives on ext4 in /var/luna/repo inside LunaBuild.
repo/
*.pkg.tar.zst
*.pkg.tar.zst.sig
*.pkg.tar.xz
*.pkg.tar.*.sig
*.db
*.db.tar.gz
*.files
*.files.tar.gz

# Directories makepkg creates while building.
pkg/*/src/
pkg/*/pkg/
pkg/*/*.log

# Images.
*.iso

# SECRET KEYS. They never belong in the repository.
# The secret half of the signing key lives only in ~builder/.gnupg on the
# build host. What belongs here, and all that belongs here, is the public
# half (pkg/luna-keyring/luna.gpg) and the fingerprint (luna-trusted).
*.gnupg/
secring*
*.key
*private*.asc
*secret*.asc

# Operating system litter.
Thumbs.db
desktop.ini
.DS_Store
